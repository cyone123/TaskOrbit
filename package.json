{
  "name": "task-orbit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm --filter @task-orbit/core build && pnpm --filter @task-orbit/mobile typecheck && tsc --noEmit && vite build",
    "test": "vitest run",
    "mobile": "pnpm --filter @task-orbit/mobile start",
    "mobile:android": "pnpm --filter @task-orbit/mobile android",
    "mobile:ios": "pnpm --filter @task-orbit/mobile ios",
    "mobile:check": "pnpm --filter @task-orbit/mobile typecheck",
    "preview": "vite preview",
    "tauri": "tauri",
    "generate:tokens": "node scripts/generate-theme-tokens.mjs"
  },
  "dependencies": {
    "@lit/react": "^1.0.8",
    "@material/web": "^2.5.0",
    "@task-orbit/core": "workspace:*",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "expo": "~57.0.14",
    "react-native": "0.86.2"
  },
  "devDependencies": {
    "@material/material-color-utilities": "^0.3.0",
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "overrides": {
      "metro-config": "0.84.4"
    }
  }
}
